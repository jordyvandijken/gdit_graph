[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/gdit_graph/sidepanel/components/status_section.gd" id="1"]

[node name="StatusSection" type="VBoxContainer"]
script = ExtResource("1")

[node name="StatusLabel" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "Ready"

[node name="StatusBar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BranchLabel" type="Label" parent="StatusBar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 13
tooltip_text = "Switch branch, create a branch, or detach HEAD"
clip_text = true
text = "-"
