[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/gdit_graph/workpanel/components/graph_dialog.gd" id="1"]

[node name="StashDialog" type="ConfirmationDialog"]
title = "Stash Changes"
ok_button_text = "Stash"
validate_name = false
