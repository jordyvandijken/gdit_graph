[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/gdit_graph/workpanel/components/settings_dialog_view.gd" id="1"]

[node name="SettingsDialog" type="ConfirmationDialog"]
title = "Git Graph Settings"
ok_button_text = "Save"
script = ExtResource("1")

[node name="DialogScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(400, 420)
horizontal_scroll_mode = 0

[node name="DialogBox" type="VBoxContainer" parent="DialogScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="SectionLoading" type="Label" parent="DialogScroll/DialogBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Loading"

[node name="SettingLoadRow" type="HBoxContainer" parent="DialogScroll/DialogBox"]
layout_mode = 2

[node name="LoadLabel" type="Label" parent="DialogScroll/DialogBox/SettingLoadRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Initial commits per page"

[node name="SettingLoadCount" type="SpinBox" parent="DialogScroll/DialogBox/SettingLoadRow"]
layout_mode = 2
tooltip_text = "Commits fetched per page (also used by Load more)"
min_value = 50.0
max_value = 1000.0
step = 50.0
value = 200.0

[node name="SettingAutoLoad" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Fetch the next page when scrolled to the bottom"
text = "Load more automatically at the bottom"

[node name="SettingOrderRow" type="HBoxContainer" parent="DialogScroll/DialogBox"]
layout_mode = 2

[node name="OrderLabel" type="Label" parent="DialogScroll/DialogBox/SettingOrderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Commit order"

[node name="SettingCommitOrder" type="OptionButton" parent="DialogScroll/DialogBox/SettingOrderRow"]
layout_mode = 2
tooltip_text = "topo: keep branches together · date/author-date: timestamp order (upstream)"
item_count = 3
item_0/text = "topo"
item_1/text = "date"
item_2/text = "author-date"

[node name="SectionColumns" type="Label" parent="DialogScroll/DialogBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Columns"

[node name="SettingAvatars" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Deterministic color + initials, generated offline"
button_pressed = true
text = "Show author avatars"

[node name="SettingHash" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Abbreviated commit hash before the subject"
button_pressed = true
text = "Show short hash column"

[node name="SettingRefs" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Current branch, other branches, and tags anchored to each commit"
button_pressed = true
text = "Show branch/tag chips"

[node name="SettingUncommitted" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Pinned Uncommitted Changes (*) row above the log when the worktree is dirty"
button_pressed = true
text = "Show uncommitted changes row"

[node name="SettingStashes" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Stash commits already in the log render as double-circle nodes"
button_pressed = true
text = "Show stash commits in graph"

[node name="SettingAuthor" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
button_pressed = true
text = "Show author column text"

[node name="SettingDate" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
button_pressed = true
text = "Show date column text"

[node name="SettingDateRow" type="HBoxContainer" parent="DialogScroll/DialogBox"]
layout_mode = 2

[node name="DateLabel" type="Label" parent="DialogScroll/DialogBox/SettingDateRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Date format"

[node name="SettingDateMode" type="OptionButton" parent="DialogScroll/DialogBox/SettingDateRow"]
layout_mode = 2
tooltip_text = "datetime: 24 Mar 2019 21:34 · date: 24 Mar 2019 · iso_*: ISO · relative: 5 minutes ago"
item_count = 5
item_0/text = "datetime"
item_1/text = "date"
item_2/text = "iso_datetime"
item_3/text = "iso_date"
item_4/text = "relative"

[node name="SettingFetchAvatars" type="CheckBox" parent="DialogScroll/DialogBox"]
layout_mode = 2
tooltip_text = "Downloads author icons once, caches under user:// (needs author emails)"
text = "Fetch Gravatar images"

[node name="SectionLayout" type="Label" parent="DialogScroll/DialogBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Layout"

[node name="SettingLaneRow" type="HBoxContainer" parent="DialogScroll/DialogBox"]
layout_mode = 2

[node name="LaneLabel" type="Label" parent="DialogScroll/DialogBox/SettingLaneRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Lane gutter width"

[node name="SettingLaneWidth" type="SpinBox" parent="DialogScroll/DialogBox/SettingLaneRow"]
layout_mode = 2
tooltip_text = "Width of one graph lane in pixels (drag the gutter edge in the graph to resize)"
min_value = 8.0
max_value = 30.0
step = 1.0
value = 16.0

[node name="SectionGraphStyle" type="Label" parent="DialogScroll/DialogBox"]
layout_mode = 2
